rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() { return request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.enabled == true; }
    match /private/{uid}/{file} {
      allow read: if request.auth != null && (request.auth.uid == uid || admin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /public/{uid}/{file} { allow read: if true; }
  }
}
