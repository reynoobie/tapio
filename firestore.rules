rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true; }
    match /admins/{uid} { allow get: if signedIn() && request.auth.uid == uid; }
    match /users/{uid} { allow read: if admin() || (signedIn() && request.auth.uid == uid); }
    match /publicProfiles/{username} { allow get: if true; }
    match /cards/{id} { allow get: if true; allow list: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid); }
    match /products/{id} { allow read: if true; }
    match /settings/store { allow read: if true; }
    match /orders/{id} { allow read: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid); }
    match /messages/{id} { allow read: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid); }
    match /analytics/{uid}/days/{day} { allow read: if admin() || (signedIn() && request.auth.uid == uid); }
    match /contactRequests/{id} { allow read: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid); }
    // All writes, username reservations, activation secrets, and price checks
    // go through the authenticated callable backend.
    match /{document=**} { allow read, write: if false; }
  }
}
